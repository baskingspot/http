{
  // Schema lives on unpkg because this repo has no node_modules.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "baskingspot-dev-http",
  // Set to the date of the last deploy-relevant config change.
  "compatibility_date": "2026-10-30",
  // Pure static site: no worker script, so no `main` and no `binding`.
  // Asset requests are free and served from cache without any invocation.
  "assets": {
    // The guide and the API reference under /http/ (see justfile `doc`).
    // The router in baskingspot/site forwards /http/... without stripping
    // the prefix, so the Worker sees the paths as built.
    "directory": "./zig-out/site",
    // Plain 404 for unknown paths (not an SPA, no 404.html).
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
  },
  // Deployed by CI after the Terraform in baskingspot/site creates this
  // Worker and attaches baskingspot.dev/http/ to it. No routes here: the
  // router owns the domain and forwards the prefix, and the deploy token is
  // scoped to this Worker only. Keep the workers.dev subdomain and the
  // preview URLs off so the site has a single canonical origin.
  "workers_dev": false,
  "preview_urls": false,
}
